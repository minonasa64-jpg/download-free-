rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 64));
    }

    function isValidUserDownload(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'url'])
        && data.userId is string && data.userId == userId
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 512
        && data.url is string && data.url.size() <= 2048;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User profile: only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket reads are prohibited
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // Downloads subcollection strictly isolated to the authenticated user
      match /downloads/{downloadId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(downloadId) && isValidUserDownload(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(downloadId);
      }
    }
  }
}
